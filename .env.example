# Copiar a .env EN LA VM y completar. El archivo .env nunca se sube a git.

# --- Aplicacion ---
FLASK_SECRET_KEY=cambiar-por-un-valor-largo-y-aleatorio
FLASK_ENV=development
APP_PORT=8000

# --- PostgreSQL (contenedor en la VM) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=devoluciones
POSTGRES_USER=devoluciones_app
POSTGRES_PASSWORD=cambiar-esta-password

# --- Redis (contenedor en la VM) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- MongoDB (contenedor en la VM, segundo parcial) ---
# Administrador del motor: solo se usa la primera vez para crear la base.
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=cambiar-esta-password
# Usuario con el que se conectan los servicios (solo lectura/escritura en MONGO_DB).
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=devoluciones
MONGO_APP_USER=devoluciones_app
MONGO_APP_PASSWORD=cambiar-esta-password

# --- JWT (servicio auth, segundo parcial) ---
# Secreto con el que se firman y validan TODOS los tokens. Minimo 32
# caracteres; el servicio no arranca si falta. Debe ser el mismo en todos los
# microservicios (lo leen del mismo .env).
JWT_SECRET=cambiar-por-un-valor-largo-y-aleatorio-de-48-caracteres
JWT_MINUTOS_ACCESO=15
JWT_HORAS_REFRESH=8
LOGIN_MAX_POR_MINUTO=10

# --- Politica de acceso (RNF-12) ---
MAX_INTENTOS_FALLIDOS=5
MINUTOS_BLOQUEO=15

# --- Datos de demostracion ---
# Contrasena de las cuentas que crea scripts/seed_demo.py. Se deja vacia a
# proposito: el repositorio es publico y una contrasena escrita aqui seria una
# contrasena regalada. Si la dejas vacia, el script genera una al azar y la
# imprime una sola vez.
PASSWORD_DEMO=

# --- Google Cloud Storage (RF-09, RNF-15) ---
# Todavia no se usa en el primer parcial; las evidencias se registran sin subir archivo.
GCS_BUCKET=
