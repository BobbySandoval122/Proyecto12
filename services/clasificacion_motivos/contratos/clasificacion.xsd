<?xml version="1.0" encoding="UTF-8"?>
<!-- Pide una sugerencia para una devolucion (POST /clasificaciones). -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="clasificacion">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="devolucion_id" type="xs:positiveInteger"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
