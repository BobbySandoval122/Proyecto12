<?xml version="1.0" encoding="UTF-8"?>
<!-- Avance reportado por el transportista (POST /api/v1/integraciones/transportistas/eventos). -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:simpleType name="IdExterno"><xs:restriction base="xs:string"><xs:pattern value="[A-Za-z0-9_.:/\-]{1,64}"/></xs:restriction></xs:simpleType>
  <xs:element name="evento">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="guia" type="IdExterno"/>
        <xs:element name="estado"><xs:simpleType><xs:restriction base="xs:string">
          <xs:enumeration value="en_transito"/><xs:enumeration value="completada"/><xs:enumeration value="fallida"/>
        </xs:restriction></xs:simpleType></xs:element>
        <xs:element name="fecha" type="xs:dateTime" minOccurs="0"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
