<?xml version="1.0" encoding="UTF-8"?>
<!-- Venta enviada por el POS (POST /api/v1/integraciones/ventas). Las listas usan <item>. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:simpleType name="IdExterno"><xs:restriction base="xs:string"><xs:pattern value="[A-Za-z0-9_.:/\-]{1,64}"/></xs:restriction></xs:simpleType>
  <xs:complexType name="Linea">
    <xs:sequence>
      <xs:element name="sku"><xs:simpleType><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="50"/></xs:restriction></xs:simpleType></xs:element>
      <xs:element name="numero_lote"><xs:simpleType><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="50"/></xs:restriction></xs:simpleType></xs:element>
      <xs:element name="cantidad" type="xs:positiveInteger"/>
      <xs:element name="precio_unitario"><xs:simpleType><xs:restriction base="xs:decimal"><xs:minInclusive value="0"/><xs:fractionDigits value="2"/></xs:restriction></xs:simpleType></xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="venta">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="id_externo" type="IdExterno"/>
        <xs:element name="tienda_externa" type="IdExterno"/>
        <xs:element name="cliente_email"><xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="[^@\s]+@[^@\s]+"/><xs:maxLength value="150"/></xs:restriction></xs:simpleType></xs:element>
        <xs:element name="fecha_venta" type="xs:date"/>
        <xs:element name="lineas">
          <xs:complexType><xs:sequence><xs:element name="item" type="Linea" minOccurs="1" maxOccurs="100"/></xs:sequence></xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
