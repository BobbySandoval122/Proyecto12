<?xml version="1.0" encoding="UTF-8"?>
<!-- Evidencia de una investigacion (POST /investigaciones/{id}/evidencias); inmutable una vez guardada. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="evidencia">
    <xs:complexType>
      <xs:all>
        <xs:element name="tipo"><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="devolucion"/><xs:enumeration value="inspeccion"/><xs:enumeration value="dato"/><xs:enumeration value="documento"/><xs:enumeration value="nota"/></xs:restriction></xs:simpleType></xs:element>
        <xs:element name="descripcion" type="xs:string"/>
        <xs:element name="devolucion_id" type="xs:string" minOccurs="0"/>
        <xs:element name="hipotesis_id" type="xs:string" minOccurs="0"/>
        <xs:element name="referencia_externa" type="xs:string" minOccurs="0"/>
      </xs:all>
    </xs:complexType>
  </xs:element>
</xs:schema>
