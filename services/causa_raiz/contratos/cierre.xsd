<?xml version="1.0" encoding="UTF-8"?>
<!-- Cierre por un supervisor o reapertura de una investigacion inconclusa (POST /cierre y /reabrir). -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="cierre">
    <xs:complexType>
      <xs:all>
        <xs:element name="comentario" type="xs:string"/>
      </xs:all>
    </xs:complexType>
  </xs:element>
</xs:schema>
