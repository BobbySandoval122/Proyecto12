#!/bin/sh
set -eu
cd "$(dirname "$0")"
if [ ! -f gradle/wrapper/gradle-wrapper.jar ]; then
  echo 'Falta gradle-wrapper.jar: ejecuta ./preparar-wrapper.sh una vez con internet.' >&2
  exit 1
fi
if [ -n "${JAVA_HOME:-}" ]; then exec "$JAVA_HOME/bin/java" -classpath gradle/wrapper/gradle-wrapper.jar org.gradle.wrapper.GradleWrapperMain "$@"; fi
exec java -classpath gradle/wrapper/gradle-wrapper.jar org.gradle.wrapper.GradleWrapperMain "$@"
